@startuml Atividades_Venda_Presencial
title Diagrama de Atividades — UC03: Realizar Venda Presencial (GoTicket)

start

:Funcionário seleciona a opção "Realizar Venda";
:Sistema exibe a lista de eventos com ingressos disponíveis (Etapa 1 - Seleção);
:Funcionário seleciona o Evento, Setor, Tipo de Ingresso e a Quantidade;

if (Quantidade solicitada <= Quantidade disponível no estoque? [Fluxo 04a]) then (sim)
  :Funcionário clica em "Continuar";
  
  partition "UC04: Cadastrar Participante" {
    :Sistema solicita os dados do participante (Etapa 2);
    :Funcionário preenche Nome, CPF, E-mail e Telefone;
    if (Dados válidos e CPF com 11 dígitos? [Fluxo 04a]) then (sim)
      :Retorna dados validados para o fluxo da venda;
    else (não)
      :Exibe erro com campo incorreto e permanece na Etapa 2;
      stop
    endif
  }

  :Sistema apresenta as opções de pagamento e resumo (Etapa 3);
  :Funcionário seleciona a Forma de Pagamento (Cartão, Dinheiro, PIX);
  :Funcionário clica em "Confirmar Venda";

  :Sistema inicia transação atômica no banco de dados;
  :Debita a quantidade de ingressos do estoque do lote;
  :Persiste o registro da Venda;
  :Gera e vincula os Ingressos com status "ATIVO / NÃO UTILIZADO";
  :Confirma a transação (COMMIT);

  partition "UC05: Emitir Comprovante / Ingresso Local" {
    :Sistema exibe tela de venda concluída (Etapa 4);
    :Renderiza Ticket Card com identificador único;
    :Disponibiliza opção de "Salvar como PDF" e "Imprimir Comprovante";
  }

  stop

else (não)
  :Exibe mensagem: "Quantidade indisponível no estoque";
  stop
endif

@enduml
