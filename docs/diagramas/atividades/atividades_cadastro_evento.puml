@startuml Atividades_Cadastro_Evento
title Diagrama de Atividades — UC01: Cadastrar Evento (GoTicket)

start

:Funcionário autenticado acessa o menu "Eventos";
:Clica na opção "+ Novo Evento";
:Sistema apresenta o formulário de cadastro (Nome, Descrição, Data, Horário, Local, Capacidade e Situação);
:Funcionário preenche os dados do evento;
:Funcionário clica em "Salvar Evento";

if (Dados obrigatórios preenchidos e válidos? [Fluxo 05a]) then (sim)
  if (Capacidade Total > 0?) then (sim)
    :Sistema valida os dados informados;
    :Sistema salva o evento no banco de dados com situação "ABERTO";
    :Sistema exibe mensagem de sucesso;
    :Atualiza a listagem de eventos;
    stop
  else (não)
    :Exibe erro: "Capacidade deve ser maior que zero";
    stop
  endif
else (não)
  :Exibe erro: "Dados obrigatórios ausentes ou inválidos";
  stop
endif

@enduml
