@startuml Sequencia_Cadastro_Evento
title Diagrama de Sequência — UC01: Cadastrar Evento (GoTicket)

actor "Funcionário" as User
boundary "EventoView / EventoController" as UI
control "EventoService" as Service
database "EventoDAO" as DAO
database "PostgreSQL" as DB

User -> UI: Clica em "+ Novo Evento"
activate UI
UI --> User: Exibe formulário modal isolado

User -> UI: Preenche Nome, Data, Horário, Local, Capacidade e clica em "Salvar Evento"

UI -> Service: cadastrar(EventoDTO)
activate Service

alt Dados válidos
    Service -> DAO: inserir(Evento)
    activate DAO
    DAO -> DB: INSERT INTO evento (nome, descricao, data_evento, hora_evento, local, capacidade_total, situacao) VALUES (...) RETURNING id
    DB --> DAO: registro inserido com ID gerado
    DAO --> Service: Evento cadastrado
    deactivate DAO

    Service --> UI: Confirmação de cadastro
    deactivate Service

    UI --> User: Exibe alerta de sucesso, fecha modal e atualiza listagem
else Dados inválidos ou ausentes
    Service --> UI: Exception("Validação falhou")
    UI --> User: Exibe alerta de aviso com o campo faltante
    deactivate UI
end

@enduml
