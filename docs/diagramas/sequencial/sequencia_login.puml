@startuml Sequencia_Login
title Diagrama de Sequência — Autenticação de Usuário (GoTicket)

actor "Funcionário" as User
boundary "LoginView / LoginController" as UI
control "UsuarioService" as Service
control "SenhaUtil" as BCrypt
database "UsuarioDAO" as DAO
database "PostgreSQL" as DB
entity "SessaoUsuario" as Sessao
boundary "MainView / DashboardController" as MainUI

User -> UI: Informa login e senha e clica em "Entrar"
activate UI

UI -> Service: autenticar(login, senha)
activate Service

Service -> DAO: buscarPorLogin(login)
activate DAO
DAO -> DB: SELECT * FROM usuario WHERE login = ? AND ativo = true
DB --> DAO: dados do usuário
DAO --> Service: Usuario
deactivate DAO

alt Usuário encontrado
    Service -> BCrypt: verificarSenha(senha, senhaHash)
    activate BCrypt
    BCrypt --> Service: true
    deactivate BCrypt

    Service --> UI: Usuario autenticado
    UI -> Sessao: iniciarSessao(usuario)
    activate Sessao
    Sessao --> UI: Sessão criada
    deactivate Sessao

    UI -> MainUI: Carrega Tela Principal (Dashboard)
    activate MainUI
    MainUI --> User: Exibe Menu e Atalhos
    deactivate MainUI

else Credenciais inválidas
    Service --> UI: Exception("Login ou senha inválidos")
    deactivate Service
    UI --> User: Exibe alerta de erro na tela
    deactivate UI
end

@enduml
