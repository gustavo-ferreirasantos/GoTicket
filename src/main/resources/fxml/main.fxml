<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eventgo.controller.MainController"
            prefHeight="720.0" prefWidth="1100.0" style="-fx-background-color: #F5F5F7;">

    <!-- SIDEBAR (Frame02MenuPrincipal) -->
    <left>
        <VBox prefWidth="240.0" spacing="4" styleClass="sidebar">
            <padding>
                <Insets top="24" right="0" bottom="24" left="0"/>
            </padding>

            <!-- Logo GoTicket -->
            <VBox style="-fx-padding: 0 24 16 24;">
                <Label text="GoTicket" styleClass="sidebar-logo"/>
            </VBox>

            <!-- Navigation Items -->
            <VBox spacing="4" VBox.vgrow="ALWAYS">
                <Button fx:id="btnNavDashboard" text="Início" maxWidth="Infinity"
                        styleClass="sidebar-item" onAction="#navDashboard"/>
                <Button fx:id="btnNavEventos" text="Eventos" maxWidth="Infinity"
                        styleClass="sidebar-item" onAction="#navEventos"/>
                <Button fx:id="btnNavVenda" text="Realizar Venda" maxWidth="Infinity"
                        styleClass="sidebar-item" onAction="#navVenda"/>
                <Button fx:id="btnNavCancelamento" text="Cancelar Ingresso" maxWidth="Infinity"
                        styleClass="sidebar-item" onAction="#navCancelamento"/>
                <Button fx:id="btnNavCheckin" text="Utilizar Ingresso" maxWidth="Infinity"
                        styleClass="sidebar-item" onAction="#navCheckin"/>
                <Button fx:id="btnNavRelatorios" text="Relatórios" maxWidth="Infinity"
                        styleClass="sidebar-item" onAction="#navRelatorios"/>
            </VBox>
        </VBox>
    </left>

    <!-- CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-panel">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>
        </StackPane>
    </center>

</BorderPane>
