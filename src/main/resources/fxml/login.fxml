<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eventgo.controller.LoginController"
      prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F5F5F7;">

    <!-- LeftPanel (Dark Navy) -->
    <VBox alignment="CENTER_LEFT" prefWidth="420.0" spacing="16" styleClass="panel-dark" HBox.hgrow="NEVER">
        <padding>
            <Insets top="0" right="48" bottom="0" left="48"/>
        </padding>

        <Label text="GoTicket" styleClass="title-brand-large"/>
        <Label text="Sistema de venda presencial de ingressos para eventos. Gerencie eventos, vendas, ingressos e relatórios em um só lugar."
               wrapText="true" maxWidth="310.0" styleClass="subtitle-dark"/>
    </VBox>

    <!-- RightPanel (White Background & Form Card) -->
    <StackPane alignment="CENTER" style="-fx-background-color: #FFFFFF;" HBox.hgrow="ALWAYS">
        <VBox alignment="CENTER_LEFT" maxWidth="340.0" spacing="16">
            <Label text="Entrar" styleClass="title-page"/>

            <!-- Field Usuário -->
            <VBox spacing="6" fillWidth="true">
                <Label text="Usuário" styleClass="field-label"/>
                <TextField fx:id="txtLogin" promptText="Digite seu usuário" onAction="#handleLogin" maxWidth="Infinity"/>
            </VBox>

            <!-- Field Senha -->
            <VBox spacing="6" fillWidth="true">
                <Label text="Senha" styleClass="field-label"/>
                <PasswordField fx:id="txtSenha" promptText="Digite sua senha" onAction="#handleLogin" maxWidth="Infinity"/>
            </VBox>

            <!-- Mensagem de Erro -->
            <Label fx:id="lblMensagem" text="" visible="false" wrapText="true"
                   style="-fx-text-fill: #DC2626; -fx-font-size: 12px;"/>

            <!-- Botão Entrar -->
            <Button fx:id="btnEntrar" text="Entrar" maxWidth="Infinity" styleClass="btn-primary" onAction="#handleLogin"/>

            <!-- Dica de perfis de acesso -->
            <VBox spacing="4" style="-fx-padding: 8 0 0 0;">
                <Label text="Perfis disponíveis:" style="-fx-font-size: 11px; -fx-text-fill: #6B7280; -fx-font-weight: bold;"/>
                <Label text="• Administrador: admin / admin123" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
                <Label text="• Funcionário: funcionario / funcionario123" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
            </VBox>
        </VBox>
    </StackPane>

</HBox>
