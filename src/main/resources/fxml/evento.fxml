<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eventgo.controller.EventoController"
           style="-fx-background-color: #FFFFFF;">

    <!-- ========================================================
         MAIN CONTENT: Frame03ListadeEventos
         ======================================================== -->
    <VBox fx:id="listaEventosPane" spacing="24" VBox.vgrow="ALWAYS" style="-fx-background-color: #FFFFFF;">

        <!-- Header: SearchBox + Novo Evento -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <TextField fx:id="txtBuscar" promptText="Buscar evento..." prefWidth="320.0"
                       onKeyReleased="#aplicarBusca"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Novo Evento" styleClass="btn-primary" onAction="#abrirModalNovoEvento"/>
        </HBox>

        <!-- Table: Frame03ListadeEventos -->
        <VBox VBox.vgrow="ALWAYS">
            <TableView fx:id="tabelaEventos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNome" text="Nome" prefWidth="240"/>
                    <TableColumn fx:id="colDataHora" text="Data/Horário" prefWidth="160"/>
                    <TableColumn fx:id="colLocal" text="Local" prefWidth="180"/>
                    <TableColumn fx:id="colCapacidade" text="Capacidade" prefWidth="110"/>
                    <TableColumn fx:id="colSituacao" text="Situação" prefWidth="120"/>
                    <TableColumn fx:id="colAcoes" text="Ações" prefWidth="220"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <!-- ========================================================
         MODAL 1: Frame04CadastrarEvento
         ======================================================== -->
    <StackPane fx:id="modalEventoOverlay" visible="false" style="-fx-background-color: #FFFFFF;" alignment="CENTER">
        <VBox styleClass="modal-card" maxWidth="480.0" spacing="16" alignment="TOP_LEFT">
            <Label fx:id="lblModalEventoTitulo" text="Cadastrar Evento" styleClass="title-modal"/>

            <!-- Field Nome do Evento -->
            <VBox spacing="6">
                <Label text="Nome do evento" styleClass="field-label"/>
                <TextField fx:id="txtEventoNome" promptText="Ex: Festival de Verão"/>
            </VBox>

            <!-- Field Descrição -->
            <VBox spacing="6">
                <Label text="Descrição" styleClass="field-label"/>
                <TextArea fx:id="txtEventoDescricao" promptText="Descreva o evento..." prefRowCount="3" wrapText="true"/>
            </VBox>

            <!-- Row Data & Horário -->
            <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Data" styleClass="field-label"/>
                    <DatePicker fx:id="dpEventoData" promptText="dd/mm/aaaa" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Horário" styleClass="field-label"/>
                    <TextField fx:id="txtEventoHorario" promptText="hh:mm"/>
                </VBox>
            </HBox>

            <!-- Field Local -->
            <VBox spacing="6">
                <Label text="Local" styleClass="field-label"/>
                <TextField fx:id="txtEventoLocal" promptText="Ex: Arena Central"/>
            </VBox>

            <!-- Row Capacidade & Situação -->
            <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Capacidade" styleClass="field-label"/>
                    <TextField fx:id="txtEventoCapacidade" promptText="Ex: 5000"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Situação" styleClass="field-label"/>
                    <ComboBox fx:id="cbEventoSituacao" maxWidth="Infinity"/>
                </VBox>
            </HBox>

            <!-- Buttons Row -->
            <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                <Button text="Cancelar" styleClass="btn-secondary" onAction="#fecharModalEvento"/>
                <Button text="Salvar Evento" styleClass="btn-primary" onAction="#salvarEvento"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- ========================================================
         MODAL 2: Frame05SetoreseLotes
         ======================================================== -->
    <StackPane fx:id="modalSetoresOverlay" visible="false" style="-fx-background-color: #FFFFFF;" alignment="CENTER">
        <VBox styleClass="modal-card" maxWidth="660.0" spacing="18" alignment="TOP_LEFT">
            <Label fx:id="lblModalSetoresTitulo" text="Setores e Lotes — Evento" styleClass="title-modal"/>

            <!-- Table Setores -->
            <TableView fx:id="tabelaSetoresLotes" prefHeight="180.0">
                <columns>
                    <TableColumn fx:id="colSetorNome" text="Nome" prefWidth="150"/>
                    <TableColumn fx:id="colSetorCapacidade" text="Capacidade" prefWidth="90"/>
                    <TableColumn fx:id="colSetorTipo" text="Tipo de ingresso" prefWidth="120"/>
                    <TableColumn fx:id="colSetorPreco" text="Preço" prefWidth="100"/>
                    <TableColumn fx:id="colSetorDisponivel" text="Disponível" prefWidth="90"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Label text="Novo Setor" styleClass="title-section"/>

            <!-- Form Novo Setor -->
            <VBox spacing="12">
                <VBox spacing="6">
                    <Label text="Nome do setor" styleClass="field-label"/>
                    <TextField fx:id="txtNovoSetorNome" promptText="Ex: Pista Premium"/>
                </VBox>

                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Capacidade do setor" styleClass="field-label"/>
                        <TextField fx:id="txtNovoSetorCapacidade" promptText="Ex: 1000"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Tipo de ingresso" styleClass="field-label"/>
                        <ComboBox fx:id="cbNovoSetorTipo" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Preço do lote" styleClass="field-label"/>
                        <TextField fx:id="txtNovoSetorPreco" promptText="Ex: R$ 150,00"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Quantidade de ingressos" styleClass="field-label"/>
                        <TextField fx:id="txtNovoSetorQuantidade" promptText="Ex: 1000"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Buttons Row -->
            <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 4 0 0 0;">
                <Button text="Fechar" styleClass="btn-secondary" onAction="#fecharModalSetores"/>
                <Button text="Adicionar Setor" styleClass="btn-primary" onAction="#adicionarSetorELote"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
